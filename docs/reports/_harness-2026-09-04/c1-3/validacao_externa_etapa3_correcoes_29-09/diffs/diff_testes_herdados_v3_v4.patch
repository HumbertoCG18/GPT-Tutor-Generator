     p.write_bytes(dados if isinstance(dados, bytes) else dados.encode("utf-8"))
 
 
+def pdf_objetos(objetos, depois=b""):
+    """v4: PDF com xref correto (corpos dos objetos 1..n; raiz = 1). O v4 recusa PDF que não abre."""
+    out, offs = bytearray(b"%PDF-1.7\n%\xe2\xe3\xcf\xd3\n"), []
+    for i, corpo in enumerate(objetos, 1):
+        offs.append(len(out))
+        out += b"%d 0 obj\n" % i + corpo + b"\nendobj\n"
+    x = len(out)
+    out += b"xref\n0 %d\n0000000000 65535 f \n" % (len(objetos) + 1) + b"".join(b"%010d 00000 n \n" % o for o in offs)
+    out += b"trailer\n<< /Size %d /Root 1 0 R >>\nstartxref\n%d\n%%%%EOF\n" % (len(objetos) + 1, x)
+    return bytes(out) + depois
+
+
+def pdf_valido(texto):
+    """v4: PDF de uma página com o texto (textos de mesmo tamanho dão PDFs de mesmo tamanho)."""
+    stream = b"BT /F1 12 Tf 72 700 Td (%s) Tj ET" % texto.encode("latin-1")
+    return pdf_objetos([b"<< /Type /Catalog /Pages 2 0 R >>", b"<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
+                        b"<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R "
+                        b"/Resources << /Font << /F1 5 0 R >> >> >>",
+                        b"<< /Length %d >>\nstream\n%s\nendstream" % (len(stream), stream),
+                        b"<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>"])
+
+
