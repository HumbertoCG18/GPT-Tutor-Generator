+def _varre_xml(dados):
+    """XML pelo expat: codificação pela declaração/BOM, entidades resolvidas; DTD e <!ENTITY> recusados (evita expansão
+    e entidade externa). Varre o texto concatenado (runs), cada atributo, comentários e instruções."""
+    texto, soltos = [], []
+
+    def recusa(*_):
+        raise XMLRecusado("XML com DTD ou declaração de entidade")
+
+    p = xml.parsers.expat.ParserCreate()
+    p.StartDoctypeDeclHandler = recusa
+    p.EntityDeclHandler = recusa
+    p.CharacterDataHandler = texto.append
+    p.StartElementHandler = lambda _nome, attrs: soltos.extend(attrs.values())
+    p.CommentHandler = soltos.append
+    p.ProcessingInstructionHandler = lambda alvo, dado: soltos.append(dado)
+    try:
+        p.Parse(dados, True)
+    except XMLRecusado as exc:
+        return str(exc)
+    except (xml.parsers.expat.ExpatError, ValueError, LookupError) as exc:
+        return f"XML ilegível ({type(exc).__name__})"
+    for t in ["".join(texto)] + soltos:
+        motivo = _varre_texto(t)
+        if motivo:
+            return motivo
+    return None
+
