+    """v4, PyMuPDF (dependência declarada do produto). Estrutural e textual são verificações separadas:
+    1. estrutura: árvore de arquivos embutidos, qualquer objeto /EmbeddedFile ou /Filespec com /EF, anotação de anexo;
+    2. texto: texto das páginas, metadados, conteúdo de anotações e URIs de links. Texto só em imagem NÃO é examinado
+       (sem OCR); `paginas_sem_texto` registra quantas páginas ficaram assim."""
+    import fitz   # lazy: só quando há PDF
+    fitz.TOOLS.mupdf_display_errors(False)
+    try:
+        doc = fitz.open(stream=dados, filetype="pdf")
+    except Exception:   # noqa: BLE001  qualquer falha de abertura = não inspecionável
+        return "PDF ilegível"
+    with doc:
+        if doc.needs_pass or doc.is_encrypted:
+            return "PDF cifrado"
+        if doc.page_count < 1:
+            return "PDF ilegível (sem páginas)"
+        if doc.embfile_count():
+            return "PDF com arquivo embutido"
+        for x in range(1, doc.xref_length()):
+            tipo = doc.xref_get_key(x, "Type")[1]
+            if tipo == "/EmbeddedFile" or (tipo == "/Filespec" and doc.xref_get_key(x, "EF")[0] != "null"):
+                return "PDF com arquivo embutido"
+        textos = [str(v) for v in (doc.metadata or {}).values() if v]
+        for pagina in doc:
+            for a in pagina.annots() or []:
+                if a.type[1] == "FileAttachment":
+                    return "PDF com arquivo embutido (anotação)"
+                textos.append(str((a.info or {}).get("content") or ""))
+            textos += [str(ln.get("uri") or "") for ln in pagina.get_links()]
+            textos.append(pagina.get_text())
+    return _varre_texto("\n".join(textos))
+
