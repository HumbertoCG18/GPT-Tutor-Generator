{
  "engine-facade-guard": {
    "PreToolUse": [
      {
        "matcher": "file_change",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/hooks/agy-adapter.js engine-facade-guard.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "gemini-antipattern-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/hooks/agy-adapter.js gemini-antipattern-guard.js",
            "timeout": 20
          }
        ]
      }
    ]
  }
}